# =============================================================================
# Root .htaccess — pengalih ke folder public/.
#
# File ini HANYA dipakai untuk kemudahan instalasi XAMPP/Laragon di mana
# folder proyek dibuka langsung (http://localhost/portohub/).
#
# Untuk produksi, lebih baik arahkan DocumentRoot Apache langsung ke folder
# public/ (lihat README bagian "Arahkan web root ke folder public"). Dengan
# begitu kode backend tidak ikut berada di dalam web root.
# =============================================================================

RewriteEngine On

# Jangan alihkan aset statis. Dalam instalasi XAMPP/Laragon di subfolder
# (contoh: http://localhost/portohub/), REQUEST_URI berisi /portohub/assets/
# sehingga pengecekan terhadap ^/assets/ tidak cocok. RewriteRule memakai
# path relatif terhadap folder proyek, jadi aturan ini tetap benar baik proyek
# dibuka dari subfolder maupun virtual host.
RewriteRule ^assets(?:/|$) - [L]

# Semua route aplikasi lainnya dilayani oleh folder public/.
RewriteRule ^(.*)$ public/$1 [L]
