# Salin file ini menjadi .env bila konfigurasi lokal Anda berbeda dari default.
# XAMPP dan Laragon standar biasanya cukup memakai nilai di bawah ini.

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfoliohub
DB_USER=root
DB_PASSWORD=

# Akun dashboard admin
# Ganti nilai ini sebelum proyek dipublikasikan.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Hanya digunakan oleh Docker Compose. Nilai ini aman untuk pengembangan lokal,
# tetapi harus diganti untuk server publik.
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=portfoliohub
MYSQL_USER=portfoliohub_user
MYSQL_PASSWORD=portfoliohub_password
