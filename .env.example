# =============================================================================
# PortfolioHub — contoh konfigurasi environment
# =============================================================================
# Salin file ini menjadi .env lalu sesuaikan bila perlu:
#
#     cp .env.example .env
#
# File .env TIDAK pernah di-commit ke Git (lihat .gitignore).
# Docker Compose, XAMPP, dan Laragon membaca nilai yang sama dari file ini.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplikasi
# -----------------------------------------------------------------------------
APP_NAME=PortfolioHub
APP_URL=http://localhost:8088

# -----------------------------------------------------------------------------
# Database MySQL
# -----------------------------------------------------------------------------
# Untuk Docker Compose, host WAJIB bernama "database" (nama service di compose).
# Untuk XAMPP/Laragon yang berjalan di host, gunakan "127.0.0.1".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_hub
DB_USER=portfoliohub_user
DB_PASSWORD=portfoliohub_password

# -----------------------------------------------------------------------------
# Akun superadmin (monitoring saja, tidak punya akses creator studio)
# -----------------------------------------------------------------------------
# Ganti kedua nilai ini sebelum proyek dipublikasikan ke server publik.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Docker Compose — hanya dipakai saat menjalankan `docker compose up`
# -----------------------------------------------------------------------------
# MYSQL_USER dan MYSQL_PASSWORD di bawah ini harus SAMA dengan DB_USER dan
# DB_PASSWORD di atas supaya aplikasi bisa login ke container database.
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_DATABASE=portfolio_hub
MYSQL_USER=portfoliohub_user
MYSQL_PASSWORD=portfoliohub_password

# Port yang dipetakan ke host (ubah bila bentrok dengan aplikasi lain).
WEB_PORT=8088
PHPMYADMIN_PORT=8082
